{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "architecture": {
      "description": "Agente guardián de arquitectura conectado a Obsidian vault",
      "mode": "subagent"
    },
    "domain": {
      "description": "Especialista en lógica de negocio",
      "mode": "subagent"
    },
    "ui": {
      "description": "Especialista Compose UI",
      "mode": "subagent"
    },
    "qa": {
      "description": "QA - build, tests, verificación",
      "mode": "subagent"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "webfetch": "ask"
  },
  "vault": {
    "path": "vault",
    "entry": "vault/00-Home.md",
    "obsidian": true
  }
}
